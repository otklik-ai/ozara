# Environment Configuration for ÖZARA
NODE_ENV=development
PORT=3000
DATABASE_URL=ozara.db
APP_SECRET=your_jwt_and_export_secret_key_minimum_32_chars_long

# Storage
STORAGE_DRIVER=local
STORAGE_DIR=./storage

# Notifications & Email Outbox
EMAIL_PROVIDER=smtp
EMAIL_OUTBOX_PATH=./.tmp/outbox.log

# Founders / Super-Admins (comma-separated)
FOUNDER_EMAILS=ermolov.elena@gmail.com,agniyahill@gmail.com,iuliiashchukinainvest@gmail.com

# SMTP / Gmail Dispatch Credentials (optional for live email delivery)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
